    "templates": {
      "group_rule": {
        "name": "群聊绑定规则",
        "display_item": "group_id",
        "items": {
          "group_id": {
            "description": "群号",
            "type": "string"
          },
          "persona_id": {
            "description": "对应人格 ID",
            "type": "string",
            "_special": "select_persona"
          }
        }
      }
